function debugTrainPath() {
    const trainStartPos = new THREE.Vector3(-10, 0.2, -5);
    const trainMiddlePos = new THREE.Vector3(0, 0.2, -10);
    const trainEndPos = new THREE.Vector3(10, 0.2, -10);

    // Red sphere at START
    const startSphere = new THREE.Mesh(
        new THREE.SphereGeometry(0.5, 8, 8),
        new THREE.MeshBasicMaterial({ color: 0xff0000 })
    );
    startSphere.position.copy(trainStartPos);
    scene.add(startSphere);


    // Green sphere at END
    const endSphere = new THREE.Mesh(
        new THREE.SphereGeometry(0.5, 8, 8),
        new THREE.MeshBasicMaterial({ color: 0x00ff00 })
    );
    endSphere.position.copy(trainEndPos);
    scene.add(endSphere);

    // Line connecting all points
    const points = [trainStartPos, trainEndPos];
    const geometry = new THREE.BufferGeometry().setFromPoints(points);
    const line = new THREE.Line(
        geometry,
        new THREE.LineBasicMaterial({ color: 0xffffff })
    );
    scene.add(line);
}

// Call it in init() after scene is created
debugTrainPath();



